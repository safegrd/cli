# Binaries and build artifacts.
# Anchored with leading slash to avoid matching directory names like cmd/safegrd.
bin/
/safegrd
/safegrd.exe
*.test
*.prof

# Test artifacts and local backups
backups/
safegrd-storage/
test-storage/
coverage.out
coverage.html

# Encrypted snapshot artifacts written by pkg/storage/local.go
*.safegrd

# Local configuration, Age keypairs, and secrets.
# The CLI writes ~/.safegrd/config.yaml and ~/.safegrd/keys/agent.key, but a
# node agent is often run from inside a checkout with a local --config, which
# carries database_url and key paths in cleartext.
.safegrd/
*.key
.env

# Unanchored config patterns so operator configs at any depth (such as
# configs/prod.yaml or agent-config.yaml) are ignored.
config.yaml
*-config.yaml
config.*.yaml
safegrd.yaml

# Any backup or rollback copy of one of those. A plain `*.prod.yaml` entry does
# not match `*.prod.yaml.bak`, which is how a copy of a live secret can sit in
# the tree looking untracked and then land in `git add -A`.
*.prod.yaml*
*.yaml.bak
*.yaml.prev
# A bare `prod.yaml` (e.g. configs/prod.yaml) has nothing before `.prod.yaml`
# for the pattern above to match, so it needs its own entry.
prod.yaml
**/prod.yaml

# Local state and scratch output a node agent writes when it is run from inside
# a checkout.
safegrd-data/
*.tmp

# IDE and OS
.DS_Store
.idea/
.vscode/

# make dist output
/dist/
