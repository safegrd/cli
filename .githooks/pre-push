#!/bin/sh
# Refuses a push that CI would fail in its first minute: every Go file the
# push changes must be gofmt-clean, and gitleaks must find no secret in the
# pushed commits (this repository is public). Installed by `make hooks`. It
# checks the commits being pushed, not the working tree.
#
# It also refuses words that belong to the private repository this one is
# developed beside: its task list, decision records, milestone and journey
# ids, and assistant attribution. In a commit message or an added line, in any
# file but this one. Removed lines stay in history, so they are stopped here.
set -eu

internal='\bCUJ\b|\bADR-?[0-9]{2,4}\b|\bM[0-9]{2,3}(\.[0-9]+)?\b|TASKS\.md|SESSION_LOG|PROD-(PLAN|RESULTS|PROGRESS)|[Cc]ontrol[ -][Pp]lane|Co-Authored-By: Claude|Claude-Session:|Generated with \[Claude Code\]'

cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
fail=0
while read -r _ local_sha _ remote_sha; do
	[ "$local_sha" = "$zero" ] && continue
	base=$remote_sha
	[ "$base" = "$zero" ] && base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
	if [ -n "$base" ]; then
		files=$(git diff --name-only --diff-filter=AM "$base" "$local_sha" -- '*.go')
	else
		files=$(git ls-tree -r --name-only "$local_sha" -- '*.go')
	fi
	for f in $files; do
		if [ -n "$(git show "$local_sha:$f" | gofmt -l 2>&1)" ]; then
			echo "Error: $f needs gofmt in the pushed commit. Run gofmt -w $f and amend." >&2
			fail=1
		fi
	done
	range="$local_sha"
	[ -n "$base" ] && range="$base..$local_sha"
	if msgs=$(git log --format='%h %s%n%b' "$range" | grep -nE "$internal"); then
		echo "Error: a commit message being pushed names something private to the developing repository:" >&2
		echo "$msgs" | head -5 >&2
		echo "    Reword the commit (git commit --amend, or git rebase -i)." >&2
		fail=1
	fi
	if [ -n "$base" ]; then
		# Each commit's own added lines: one removed by a later commit of
		# the same push is still in history.
		added=$(git log -p --format='commit %h' "$range" -- . ':(exclude).githooks/pre-push' |
			awk '/^commit [0-9a-f]+$/ {c=$2} /^\+[^+]/ {print c": "$0}' | grep -E "$internal" || true)
		if [ -n "$added" ]; then
			echo "Error: lines being pushed name something private to the developing repository:" >&2
			echo "$added" | head -5 >&2
			echo "    This repository is public. Say what the code does, not which journey or milestone found it." >&2
			fail=1
		fi
	fi
	if command -v gitleaks >/dev/null; then
		range="$local_sha"
		[ -n "$base" ] && range="$base..$local_sha"
		if ! gitleaks git --no-banner --redact --exit-code 1 --log-opts="$range" . >/dev/null 2>&1; then
			gitleaks git --no-banner --redact --exit-code 1 --log-opts="$range" . 2>&1 | grep -E "^(Finding|File|Line|Commit):" >&2 || true
			echo "Error: gitleaks found a secret in the commits being pushed. Remove it and rewrite the commit." >&2
			fail=1
		fi
	else
		echo "Error: gitleaks is not installed, so the push was not scanned for secrets: brew install gitleaks" >&2
		fail=1
	fi
done
exit $fail
